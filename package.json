{
  "name": "rotom-dex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -s dev:web",
    "dev:web": "pnpm -s -F @rotom/web dev",
    "build": "pnpm -s build:web",
    "build:web": "pnpm -s -F @rotom/web build",
    "preview": "pnpm -s -F @rotom/web preview",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint apps/web --fix",
    "lint:eslint": "eslint apps/web --fix --cache",
    "format": "prettier --write --experimental-cli apps/web/src/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@11.9.0"
}
